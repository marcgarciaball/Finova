# Finova — environment variables
# Copy to `.env.local` and fill in. Validated at boot by lib/validation/env (P0-03);
# the app fails fast if any required var is missing or malformed. Never commit real values.

# --- Supabase (client-safe, exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# --- Supabase (server-only secrets, NEVER prefixed NEXT_PUBLIC) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Database (Drizzle migrations + server queries) ---
# Use the Supabase pooled connection string for the app, direct for migrations.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# --- App ---
# Server-known origin used to pin auth redirect URLs (callback hardening, P0-05).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
