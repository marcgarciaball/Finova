# Finova — environment variables
# Copy to `.env.local` and fill in. Validated at boot by lib/validation/env (P0-03);
# the app fails fast if any required var is missing or malformed. Never commit real values.

# --- Supabase (client-safe, exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# --- Supabase (server-only secrets, NEVER prefixed NEXT_PUBLIC) ---
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxx"

# --- Database (Drizzle) ---
# Copy these from Supabase → "Connect", replacing [PASSWORD] only. Keep the
# real host + the `postgres.<project-ref>` username exactly as shown there.
#   DATABASE_URL = Transaction pooler (port 6543) — used by the running app
#   DIRECT_URL   = Session pooler   (port 5432) — used by `npm run db:migrate`
# Don't use the IPv6-only "Direct connection" (db.<ref>.supabase.co); the
# session pooler is the IPv4 equivalent that migrations need.
DATABASE_URL="postgresql://postgres.YOUR-REF:[PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR-REF:[PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# --- App ---
# Server-known origin used to pin auth redirect URLs (callback hardening, P0-05).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Finnhub ---
FINNHUB_API_KEY="your-finnhub-api-key"

# --- FMP ---
FMP_API_KEY="your-fmp-api-key"
